{
  "name": "xiaoluo-hot-list-publisher",
  "main": "worker/hot-daily.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "triggers": { "crons": ["0 0 * * *", "15 3 * * *"] },
  "services": [
    { "binding": "DAILY_GENERATOR", "service": "xiaoluo-daily-generator" },
    { "binding": "HOT_DETAIL", "service": "xiaoluo-hot-detail" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaoluo-visitor-stats",
      "database_id": "bf4ffb2e-1441-4556-9507-d88594e05dd1"
    }
  ]
}
